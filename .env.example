# ── Auth (Clerk) — shared across nextjs + admin builds ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── App URLs ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3002
BACKEND_URL=http://localhost:8000

# ── Database — only needed for `pnpm dev:realdb` (docker-compose.realdb.yml).
DATABASE_URL=
MIGRATIONS_DATABASE_URL=

# ── Rate limits (frontend-visible copies of backend limits) ──
NEXT_PUBLIC_RATE_LIMIT_LINKEDIN=10
NEXT_PUBLIC_RATE_LIMIT_RESUME_AI=8
NEXT_PUBLIC_RATE_LIMIT_RESUME_PDF=20
NEXT_PUBLIC_RATE_LIMIT_COVER_LETTER=5
NEXT_PUBLIC_RATE_LIMIT_INTERVIEW=10
NEXT_PUBLIC_RATE_LIMIT_SALARY=5
NEXT_PUBLIC_RATE_LIMIT_JOB_SEARCH=10
NEXT_PUBLIC_RATE_LIMIT_BULK_CAMPAIGN=500
NEXT_PUBLIC_RATE_LIMIT_BULK_MONTH=3000
NEXT_PUBLIC_RATE_LIMIT_STARTUP_HUNT=8

# ── Bulk email ──
NEXT_PUBLIC_BULK_EMAIL_MIN_DELAY=20
NEXT_PUBLIC_BULK_EMAIL_DEFAULT_DELAY=30

# ── LinkedIn cache ──
NEXT_PUBLIC_LINKEDIN_CACHE_TTL_DAYS=7
